PORT=8000
NODE_ENV=development
# memory (array, se pierde al reiniciar) | sequelize (SQLite en database.sqlite; se crea solo y borrarlo vuelve a la semilla)
PERSISTENCE_TYPE=memory
# console (default) | file: por dónde sale el aviso de orden.creada (la tabla para colocar a mano)
NOTIFIER_TYPE=console
# Archivo de los avisos a archivo (activo.topeCerca siempre; orden.creada con NOTIFIER_TYPE=file)
NOTIFICATIONS_LOG_PATH=notifications.log
# activo.topeCerca: avisa cuando cartera + compras vivas llega a este % del topeCedears (0 < valor <= 100)
TOPE_CERCA_PCT=90
