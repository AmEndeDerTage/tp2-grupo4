PORT=8000
# Dirección en la que escucha: 127.0.0.1 = solo esta máquina (default). Para abrirla a la red, a propósito: 0.0.0.0
HOST=127.0.0.1
# development (default) | production: en production no se publica la documentación (/api-docs)
NODE_ENV=development
# memory (array, se pierde al reiniciar) | sequelize (SQLite en database.sqlite; se crea solo y borrarlo vuelve a la semilla)
PERSISTENCE_TYPE=memory
# console (default) | file: por dónde salen los avisos de orden.creada (la tabla para colocar a mano) y orden.ejecutada
NOTIFIER_TYPE=console
# Archivo de los avisos a archivo (activo.topeCerca siempre; orden.creada y orden.ejecutada con NOTIFIER_TYPE=file)
NOTIFICATIONS_LOG_PATH=notifications.log
# activo.topeCerca: avisa cuando cartera + compras vivas llega a este % del topeCedears (0 < valor <= 100)
TOPE_CERCA_PCT=90
# Reloj: vacío = la hora real. Con una fecha ISO (p. ej. 2026-12-01T12:00:00-03:00) queda fijo, para probar las reglas que miran la fecha
CLOCK_NOW=
# Límites de pedidos por IP y por minuto (0 = sin límite): a toda la API, y de intentos fallidos de inicio de sesión
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=5
# Secreto que firma los tokens (obligatorio, 32 caracteres o más). Este es de ejemplo: generá el tuyo con
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-ejemplo
# Vida de cada token: 15m, 1h, 7d
JWT_EXPIRES_IN=1h
# El operador: el único usuario, el que puede escribir. Acá va el HASH bcrypt de su contraseña, nunca la contraseña.
# El de ejemplo corresponde a la contraseña mellon-1234. Para usar otra: node scripts/hash.js "mi contraseña"
OPERADOR_USUARIO=operador
OPERADOR_PASSWORD_HASH=$2b$10$HUE5eAZdmTruZQxJiIypzu90RXitBKErq2R59wieW.886Ug0JyRRi
